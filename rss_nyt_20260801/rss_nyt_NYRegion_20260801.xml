      <category domain="http://www.nytimes.com/namespaces/keywords/nyt_geo">New York City</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Malnutrition</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Autism</category>
      <media:content height="1800" medium="image" url="https://static01.nyt.com/images/2026/08/01/nyregion/01met-bronx-1111/01met-bronx-1111-mediumSquareAt3X.jpg" width="1800"></media:content>
      <media:credit>Christine Valentin</media:credit>
      <media:description>Prosecutors say that Adonis Jarvis, 16, died of starvation and dehydration under the care of his mother and grandmother. The two women were arrested on Thursday.</media:description>
