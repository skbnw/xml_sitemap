    <item>
      <title>Mercury Is Shrinking, and Faster Than We Thought</title>
      <link>https://www.nytimes.com/2026/09/11/science/space/mercury-shrinking-wrinkles.html</link>
      <guid isPermaLink="true">https://www.nytimes.com/2026/09/11/science/space/mercury-shrinking-wrinkles.html</guid>
