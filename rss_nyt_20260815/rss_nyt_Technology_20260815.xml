      <category domain="http://www.nytimes.com/namespaces/keywords/nyt_org">Google Inc</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">E-Learning</category>
      <media:content height="1802" medium="image" url="https://static01.nyt.com/images/2026/08/13/multimedia/13Gemini-schools-wgzl/13Gemini-schools-wgzl-mediumSquareAt3X.jpg" width="1800"></media:content>
      <media:credit>Ysa Pérez for The New York Times</media:credit>
