      <category domain="http://www.nytimes.com/namespaces/keywords/nyt_per">Peterson, Oscar</category>
      <media:content height="1800" medium="image" url="https://static01.nyt.com/images/2026/09/14/multimedia/14obit-jones--jpbk/14obit-jones--jpbk-mediumSquareAt3X.jpg" width="1800"></media:content>
      <media:credit>Stéphane Ouzounoff/Hans Lucas, via Agence France-Presse — Getty Images</media:credit>
