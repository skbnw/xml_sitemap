      <category domain="http://www.nytimes.com/namespaces/keywords/des">Telescopes and Observatories</category>
      <media:content height="1802" medium="image" url="https://static01.nyt.com/images/2026/08/12/multimedia/12SCI-MOTHRA-TELESCOPE-01-cfmh/12SCI-MOTHRA-TELESCOPE-01-cfmh-mediumSquareAt3X.jpg" width="1800"></media:content>
      <media:credit>MOTHRA Telescope Array/NASA, ESA, C. R. O’Dell and M. Meixner, P. McCullough and G. Bacon</media:credit>
