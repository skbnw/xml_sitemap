      <guid isPermaLink="true">https://www.nytimes.com/2026/08/28/science/an-experimental-single-time-treatment-slashed-cholesterol-for-a-year.html</guid>
      <atom:link href="https://www.nytimes.com/2026/08/28/science/an-experimental-single-time-treatment-slashed-cholesterol-for-a-year.html" rel="standout"></atom:link>
      <description>A small gene-editing study significantly reduced LDL cholesterol levels, and the results have stuck a year later.</description>
      <dc:creator>Carolyn Y. Johnson</dc:creator>
      <pubDate>Fri, 28 Aug 2026 14:30:05 +0000</pubDate>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Cholesterol</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Genetic Engineering</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/des">Clinical Trials</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/nyt_org">New England Journal of Medicine</category>
      <category domain="http://www.nytimes.com/namespaces/keywords/nyt_org">CRISPR Therapeutics</category>
      <media:content height="1800" medium="image" url="https://static01.nyt.com/images/2026/08/28/science/28SCI-CHOLESTEROL-EDIT/28SCI-CHOLESTEROL-EDIT-mediumSquareAt3X.jpg" width="1800"></media:content>
      <media:credit>Juan Gaertner/Science Photo Library, via Alamy</media:credit>
      <media:description>An illustration of “bad” cholesterol molecules, in yellow, binding to receptors, in blue-purple. In the study, patients saw their “bad” LDL cholesterol and triglycerides levels drop by up to 50 percent — and remain steady a year later.</media:description>
